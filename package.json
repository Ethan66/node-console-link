{
  "name": "node-console-link",
  "version": "2.0.5",
  "description": "Auto-inject console.log into business functions for Vue2/Vue3 projects",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./webpack": "./dist/webpack/loader.js",
    "./vite": "./dist/vite/plugin.js",
    "./runtime": "./dist/runtime/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ethan66/node-console-link"
  },
  "scripts": {
    "test": "node ./test/test.js",
    "build": "rollup -c rollup.config.mjs",
    "pub": "yarn build && npm publish --registry=https://registry.npmjs.org/"
  },
  "keywords": ["console", "debug", "vue", "webpack-loader", "vite-plugin"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.1",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "prettier": "^2.8.8",
    "rollup": "^3.25.1",
    "rollup-plugin-terser": "^7.0.2",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^35.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "typescript": "*"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0"
  },
  "volta": { 
    "node": "20.10.0",
    "yarn": "1.22.19"
  }
}
